<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: EF Core / SQL Server and other adapters that implement Application ports. -->
  <PropertyGroup>
    <RootNamespace>SpencerDenim.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!--
    Plain Sdk (not Sdk.Web): AddIdentity, UserManager/SignInManager/RoleManager and cookie authentication live in
    the ASP.NET Core shared framework rather than a separately restorable package, so a class library needs this
    to use them (the documented pattern for Identity outside a Web SDK project). No hosting/Kestrel is pulled in.
    Once this is present, the SDK's package-pruning feature treats Microsoft.Extensions.Diagnostics.HealthChecks,
    Microsoft.Extensions.Options.ConfigurationExtensions and Microsoft.Extensions.Caching.Memory as already
    supplied by the framework (NU1510), so they are deliberately not also listed as PackageReference below.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpencerDenim.Application\SpencerDenim.Application.csproj" />
  </ItemGroup>

  <!--
    The demo seeder's deterministic generator and its media placeholder descriptors are implementation
    details with tests on them: the unit tests check what a placeholder looks like, and the integration
    tests drive the generator against a real database and a real volume.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SpencerDenim.UnitTests" />
    <InternalsVisibleTo Include="SpencerDenim.IntegrationTests" />
  </ItemGroup>

</Project>
