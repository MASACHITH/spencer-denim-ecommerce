{
  "name": "spencer-denim-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve storefront",
    "build": "ng build storefront",
    "watch": "ng build storefront --watch --configuration development",
    "test": "npm run test:ci",
    "serve:ssr:storefront": "node dist/storefront/server/server.mjs",
    "lint": "ng lint",
    "start:storefront": "ng serve storefront",
    "start:admin": "ng serve admin",
    "build:shared": "ng build shared",
    "build:storefront": "ng build storefront",
    "build:admin": "ng build admin",
    "build:all": "ng build shared && ng build storefront && ng build admin",
    "test:ci": "ng test shared --watch=false && ng test storefront --watch=false && ng test admin --watch=false",
    "test:e2e": "npm run build:storefront && npm run build:admin && playwright install chromium && playwright test",
    "audit:gate": "node ../../tools/audit/audit-gate.mjs npm"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.10.0",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/ssr": "^21.2.27",
    "@fontsource/inter": "^5.3.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.13.5",
    "angular-eslint": "21.4.0",
    "axe-core": "4.13.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
