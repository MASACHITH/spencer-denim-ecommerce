<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SpencerDenim.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\SpencerDenim.Domain\SpencerDenim.Domain.csproj" />
    <ProjectReference Include="..\..\src\backend\SpencerDenim.Application\SpencerDenim.Application.csproj" />
    <ProjectReference Include="..\..\src\backend\SpencerDenim.Infrastructure\SpencerDenim.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\SpencerDenim.Api\SpencerDenim.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Shared media fixtures: real images and MP4 containers, built byte by byte so both test projects
       exercise the same files and no binary fixture has to be trusted. -->
  <ItemGroup>
    <Compile Include="..\Shared\TestImages.cs" Link="Support\TestImages.cs" />
    <Compile Include="..\Shared\TestVideos.cs" Link="Support\TestVideos.cs" />
  </ItemGroup>

</Project>
