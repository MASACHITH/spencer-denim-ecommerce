<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests. SQL-backed tests need TEST_SQL_CONNECTION (see README) and are skipped without it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SpencerDenim.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\SpencerDenim.Api\SpencerDenim.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Shared media fixtures: real images and MP4 containers, built byte by byte so both test projects
       exercise the same files and no binary fixture has to be trusted. -->
  <ItemGroup>
    <Compile Include="..\Shared\TestImages.cs" Link="Support\TestImages.cs" />
    <Compile Include="..\Shared\TestVideos.cs" Link="Support\TestVideos.cs" />
  </ItemGroup>

</Project>
