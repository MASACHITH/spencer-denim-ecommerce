<Project>
  <!-- Shared build settings for every .NET project (src/backend and tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>TU2SL</Company>
    <!-- The shop's name, for the assemblies' file metadata. MSBuild cannot read
         SpencerDenim.Domain.Branding.StoreBrand.Name, so this is one of the three files
         BrandNameConventionTests allows to spell it out. The assembly *names* stay SpencerDenim.*. -->
    <Product>Colombo Wardrobe E-Commerce Platform</Product>
    <Copyright>TU2SL</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
