#!/bin/sh
# Pre-push safety check for spencer-denim-ecommerce.
#
# Purpose: make sure this private client repository (client names, pricing, signed
# proposal) is only ever pushed to the correct repository, and never with the
# office account. See docs/09-git-and-repository-rules.md
#
# Approved contributors may push. Add someone only after the project owner has
# granted them write access on GitHub.

EXPECTED_URL_PART="github.com/MASACHITH/spencer-denim-ecommerce"
ALLOWED_ACCOUNTS="MASACHITH tharanganuwan"
BLOCKED_ACCOUNTS="destinity-sachithm"
PUSH_URL="$2"

fail() {
  echo ""
  echo "PUSH BLOCKED (spencer-denim-ecommerce): $1"
  echo "This project may only be pushed to https://$EXPECTED_URL_PART"
  echo "Approved accounts: $ALLOWED_ACCOUNTS"
  echo "See docs/09-git-and-repository-rules.md"
  echo ""
  exit 1
}

# 1) The destination repository must be the right one. This is the check that matters most.
case "$PUSH_URL" in
  *"$EXPECTED_URL_PART"*) ;;
  *) fail "push URL is '$PUSH_URL'." ;;
esac

# 2) If the GitHub CLI is available, check which account would be used.
if ! command -v gh >/dev/null 2>&1; then
  echo "note: GitHub CLI not found, so the account could not be verified."
  echo "      The destination repository is correct, so the push continues."
  echo "      Never push this project with an office/company account."
  exit 0
fi

ACTIVE_ACCOUNT=$(gh api user --jq .login 2>/dev/null)

if [ -z "$ACTIVE_ACCOUNT" ]; then
  echo "note: GitHub CLI is installed but not logged in, so the account could not be verified."
  echo "      The destination repository is correct, so the push continues."
  exit 0
fi

for blocked in $BLOCKED_ACCOUNTS; do
  if [ "$ACTIVE_ACCOUNT" = "$blocked" ]; then
    fail "active GitHub account is '$ACTIVE_ACCOUNT', which is an office account and must never push this project."
  fi
done

for allowed in $ALLOWED_ACCOUNTS; do
  if [ "$ACTIVE_ACCOUNT" = "$allowed" ]; then
    exit 0
  fi
done

fail "active GitHub account is '$ACTIVE_ACCOUNT', which is not on the approved list. Ask the project owner to add you (docs/09 §1b)."
