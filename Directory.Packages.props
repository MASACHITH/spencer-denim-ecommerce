<Project>
  <!-- Central package management: versions live here only, csproj files reference packages without Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <!--
      A transitive pin, not a dependency of ours: Microsoft.EntityFrameworkCore.SqlServer 10.0.12 brings
      Microsoft.Data.SqlClient 6.1.6, which brings System.Security.Cryptography.Pkcs 9.0.11. On
      2026-10-14 NuGet audit began reporting two .NET denial-of-service advisories against it
      (CVE-2026-84008 / GHSA-846f-f764-76mx, high; CVE-2026-70162 / GHSA-2fmv-rv2c-59x7, moderate), and
      with TreatWarningsAsErrors every restore of this repository failed - main included. 10.0.13 is
      the first patched 10.x release, and CentralPackageTransitivePinningEnabled makes this line raise
      the transitive version. Remove it once EF Core / SqlClient ship a release that depends on a
      patched version themselves.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--
      Imaging for the media library (W1-04, ADM-18). SkiaSharp is MIT and is what doc 03 §2 names;
      SixLabors.ImageSharp is deliberately not used (Six Labors Split License, not free above their
      revenue threshold), for the same reason MediatR and AutoMapper are not.
      The second id is not a second dependency: it is the same library's self-contained Linux native
      asset, so the API image needs no libfontconfig1/libfreetype6 layer (doc 03 §4).
    -->
    <PackageVersion Include="SkiaSharp" Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <!--
      The allow-list HTML sanitiser doc 08 §3.7/§3.8 requires for content-page bodies (GLB-10) and for
      every ValueType 2 setting. MIT, and parser-based: it is AngleSharp's HTML5 parser plus an
      allow-list walk over the resulting DOM, which is the only approach that survives a malformed or
      nested payload. A hand-written one over regular expressions is the documented wrong answer to
      this problem, and a stored-XSS surface on a public page is not the place to find out why.
    -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <!--
      HtmlSanitizer's own HTML5 parser, listed explicitly because `HtmlSanitiser` uses it directly to
      count the images a cleaned body holds (doc 08 §3.3's alt-text rule needs that number). A
      transitive dependency that source code calls is a dependency, and pinning it here is what stops a
      future HtmlSanitizer bump moving it silently. MIT.
    -->
    <PackageVersion Include="AngleSharp" Version="1.7.2" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
