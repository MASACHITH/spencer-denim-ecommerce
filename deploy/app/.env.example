# Spencer Denim application stack: environment file template (W0-15, docs/15-deployment-runbook.md §4).
#
# On the server this is /opt/apps/<env>/spencer-denim-app/config/app.env, owned by root, mode 600. Never commit a
# filled-in copy. Every value below is a placeholder; scripts/check-env.sh refuses to run while any CHANGE_ME
# remains. Non-secret, per-environment settings (port, subnet, limits) are in compose.<env>.yml, not here.
#
# Quoting: compose reads this file literally. Do not wrap values in quotes, and avoid $ in passwords
# (compose would try to interpolate it); scripts/check-env.sh warns about both.

# --- Images ------------------------------------------------------------------------------------------------------
# scripts/deploy.sh sets SD_IMAGE_TAG itself (the git commit being deployed); set it here only to pin by hand.
# SD_IMAGE_TAG=
SD_IMAGE_REPOSITORY=spencer-denim

# --- Public host name(s) -----------------------------------------------------------------------------------------
# The storefront renders only for these (NG_ALLOWED_HOSTS, comma-separated). Must match the host nginx server_name.
SD_PUBLIC_HOSTS=CHANGE_ME.example.com

# The public origin, scheme and host only (no path, no trailing slash): https://colombowardrobecompany.com in
# production, https://staging.<domain> on staging. It goes into robots.txt, sitemap.xml, og:url (#86) and every
# link in an order email. It is never worked out from the request, so a wrong value here is published as is.
SD_PUBLIC_ORIGIN=https://CHANGE_ME.example.com

# --- Email (optional until the client's SMTP credentials arrive) -------------------------------------------------
# Unset, order emails are queued but not sent and the admin banner says so. Avoid $ in the password.
SD_SMTP_HOST=
SD_SMTP_PORT=587
SD_SMTP_USERNAME=
SD_SMTP_PASSWORD=
SD_SMTP_FROM_ADDRESS=
SD_SMTP_FROM_NAME=

# --- Traffic recording (optional; docs/15 §4) --------------------------------------------------------------------
# Every line may stay as it is: the defaults are what the shop runs on. The two retention periods are a FALLBACK —
# the admin Settings screen's Traffic form (seeded 90 and 7) wins whenever it holds a value; these apply only if
# that row is ever unset or damaged. Configuration accepts 4-3650 days (bots no longer than people); the form
# accepts 30-365 and 7-90.
SD_TRAFFIC_RECORDING_ENABLED=true
# The shop's own host names, comma-separated, e.g. colombowardrobecompany.com,www.colombowardrobecompany.com.
SD_TRAFFIC_INTERNAL_HOSTS=
SD_TRAFFIC_RAW_RETENTION_DAYS=90
SD_TRAFFIC_BOT_RETENTION_DAYS=7

# --- Database ----------------------------------------------------------------------------------------------------
# Two logins (doc 08 §10.4), created by scripts/db-provision.sh:
#   sd_<env>_app       db_datareader + db_datawriter: the API
#   sd_<env>_migrator  db_owner: the one-shot migrator only
# Server=sqlserver resolves on the sd-<env>-db network. TrustServerCertificate: the container's self-signed
# certificate, on a private internal network with no route out.
# Database: SpencerDenim (production) / SpencerDenim_Staging (staging).
SD_APP_DB_CONNECTION=Server=sqlserver,1433;Database=SpencerDenim;User Id=sd_production_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True
SD_MIGRATOR_DB_CONNECTION=Server=sqlserver,1433;Database=SpencerDenim;User Id=sd_production_migrator;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# 170 = SQL Server 2025 / Azure SQL (the database stack's image). 150 = SQL Server 2019.
SD_DB_COMPATIBILITY_LEVEL=170

# --- First Super Admin (optional, first install only) ------------------------------------------------------------
# Set true once to create the first admin at start-up, sign in, then set it back to false and redeploy.
# Idempotent: an existing account is never changed.
# The password follows the same rule as every other account: at least 10 characters, with an upper-case letter,
# a lower-case letter, a number and a symbol (not $, and not starting with a quote: compose reads this file
# literally). A shorter one creates no account, and scripts/check-env.sh refuses it while the seed is on.
SD_SEED_ADMIN_ENABLED=false
SD_SEED_ADMIN_EMAIL=
SD_SEED_ADMIN_PASSWORD=

# --- Protected staff accounts (optional, any time) ---------------------------------------------------------------
# Email addresses, separated by commas, semicolons or spaces, of staff accounts that must never be deactivated
# (typically the vendor's support Super Admin). The Staff users screen then shows no Deactivate button for them, the
# API refuses the request, and their email address cannot be changed (so the account cannot be renamed and then
# deactivated). Takes effect on the next deploy. Leave empty to protect nobody. A malformed address stops the API at
# start-up on purpose: a typo here would otherwise leave the account unprotected without telling anyone.
SD_PROTECTED_STAFF_EMAILS=

# --- Guarded staff accounts (optional, any time) -----------------------------------------------------------------
# Same format. An account handed to someone else, such as the client's own Super Admin: only a PROTECTED account (the
# list above) may deactivate it, reactivate it or change its email address, so the people who use it, other Super
# Admins included, cannot lock it out. The Staff users screen shows them no button and a short note instead. Needs
# SD_PROTECTED_STAFF_EMAILS to be set as well (the API refuses to start otherwise: nobody could ever change the
# guarded account). Takes effect on the next deploy. Leave empty to guard nobody.
SD_GUARDED_STAFF_EMAILS=

# --- Data Protection certificate (optional, recommended; docs/16) -----------------------------------------------
# Encrypts the Data Protection key ring at rest. Leave BOTH empty and nothing changes: the key ring is then stored
# unencrypted on the volume (only root and the API can read it). Make the certificate with
#   sudo scripts/make-dp-cert.sh <env>
# BEFORE the first deploy (the key ring is created by the first API start), or at the latest before any PayPal
# credential is saved in the admin Settings. The script prints the password ONCE: keep it and a copy of the .pfx
# OFF this server, because a key ring restored without them cannot be read.
# SD_DP_CERT_FILE is a file name inside config/dataprotection/ (not a path). check-env.sh refuses one without the other.
SD_DP_CERT_FILE=
SD_DP_CERT_PASSWORD=

# --- Data directory (optional) -----------------------------------------------------------------------------------
# Defaults to ../data relative to the compose directory, i.e. /opt/apps/<env>/spencer-denim-app/data.
# SD_DATA_DIR=

# --- Order-placement limit (optional, #107) ----------------------------------------------------------------------
# Orders one visitor address may place in one window (POST /api/checkout/orders); over it the shopper is told to wait
# and press Place order again. The defaults suit a shop that is not on a campaign. Raise PERMITS for a campaign day if
# shoppers behind one mobile-carrier address are refused. SHARED_PERMITS (the budget when the API cannot see the
# visitor's own address) must be at least PERMITS, or the API refuses to start. Apply with a redeploy: the API container
# is recreated, and these variables reach it only through compose.yml.
# SD_ORDER_THROTTLE_PERMITS=20
# SD_ORDER_THROTTLE_SHARED_PERMITS=200
# SD_ORDER_THROTTLE_WINDOW_SECONDS=600
