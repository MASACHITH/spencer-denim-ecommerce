# Spencer Denim SQL Server stack: environment file template (W0-15, docs/15-deployment-runbook.md §5).
#
# On the server this is /opt/server/database/<env>/config/db.env, owned by root, mode 600. Never commit a filled-in
# copy. Every value below is a placeholder; scripts/check-env.sh refuses to run while any CHANGE_ME remains.

# production | staging (or a short local name on a developer machine, e.g. "local")
SD_ENV=production

# The sa password: used only by the healthcheck and by scripts/db-provision.sh, never by the application.
# SQL Server's policy: at least 8 characters from three of upper case, lower case, digits and symbols.
# Avoid $ and " so the value survives compose interpolation and shell quoting unchanged.
SD_MSSQL_SA_PASSWORD=CHANGE_ME

# Edition. Express is free for production (doc 03 §2). "Developer" is for local machines only.
SD_MSSQL_PID=Express

# Memory: SQL Server's own limit and the container's hard ceiling above it (doc 03 §4 RAM budget).
# Production 2048 / 2560m. Staging 1024 / 1536m.
SD_MSSQL_MEMORY_LIMIT_MB=2048
SD_MSSQL_CONTAINER_MEMORY=2560m
