# Client progress page: always serve the current version.
# Without this, Hostinger sends Cache-Control: public, max-age=604800 (7 days),
# so the client keeps seeing an old page after we publish an update.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header unset Cache-Control
    Header unset Expires
    Header unset Pragma
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
</IfModule>

# LiteSpeed (Hostinger) page cache off for this small site
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# index.html takes priority over Hostinger's default placeholder
DirectoryIndex index.html default.php index.php
